# Node.js 24. Values here are placeholders, not the original studio credentials.
# Create .env.local for development; set the same two variables in your hosting dashboard.
# Production requires explicit configuration. Without both variables, development is local demo only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy anon key is supported instead of PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Never put a secret/service_role key, DB password or Google client secret in VITE_* variables.
